PORT=3000
SESSION_SECRET=
TEAM_MAPPINGS_PATH=

# On-prem storage (raw uploads, derived data, audit log). STORAGE_ENCRYPTION_KEY
# must be a 32-byte key, hex-encoded (64 hex chars) - e.g. generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
STORAGE_DIR=./data
STORAGE_ENCRYPTION_KEY=

# How long a manager invite link stays valid, in milliseconds. Defaults to
# 7 days if unset.
MANAGER_INVITE_EXPIRY_MS=

# Local testing only: log in as any email with no verification, bypassing
# Knox entirely. Leave unset/false everywhere except your own machine.
DEV_LOGIN_ENABLED=false

# Samsung Knox OIDC (pending confirmation - see technical-architecture-spec.md Section 6.1)
KNOX_ISSUER=
KNOX_AUTHORIZATION_ENDPOINT=
KNOX_TOKEN_ENDPOINT=
KNOX_JWKS_URI=
KNOX_CLIENT_ID=
KNOX_CLIENT_SECRET=
KNOX_REDIRECT_URI=
